<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DLSSFrameGenEnabler_WinUI3.Pages.SettingsPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DLSSFrameGenEnabler_WinUI3.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16">
        <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24">
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" Text="设置" />

            <StackPanel Spacing="8">
                <TextBlock x:Name="AppearanceText" Text="外观" FontWeight="SemiBold" FontSize="14" />
                <ToggleSwitch x:Name="DarkModeToggle" Header="深色模式" OffContent="浅色模式" OnContent="深色模式" Toggled="DarkModeToggle_Toggled" />
                <ToggleSwitch x:Name="AnimationToggle" Header="动画效果" OffContent="关闭" OnContent="开启" Toggled="AnimationToggle_Toggled" />
                <TextBlock x:Name="AnimationDescText" Text="关闭后将禁止页面切换和深浅色切换等所有动画，以减少性能占用" FontSize="12" Opacity="0.6" Margin="0,0,0,8" />
                <ComboBox x:Name="BackdropCombo" Header="界面材质" SelectionChanged="BackdropCombo_SelectionChanged">
                    <ComboBoxItem Content="默认" Tag="0" />
                    <ComboBoxItem Content="云母 Mica" Tag="1" />
                    <ComboBoxItem Content="亚克力 Acrylic" Tag="2" />
                    <ComboBoxItem Content="纯透明 Pure Transparent" Tag="5" />
                    <ComboBoxItem Content="自定义壁纸" Tag="4" />
                </ComboBox>
                <TextBlock x:Name="TransparentTipText" Text="注意：纯透明材质下切换深浅色模式后，需要重启软件才能显示正确颜色" FontSize="12" Opacity="0.6" Margin="0,4,0,8" Visibility="Collapsed" />
                <StackPanel x:Name="WallpaperButtons" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <Button x:Name="SelectWallpaperBtn" Content="选择图片" Click="SelectWallpaperBtn_Click" />
                    <Button x:Name="ResetWallpaperBtn" Content="恢复默认" Click="ResetWallpaperBtn_Click" />
                </StackPanel>
                <ComboBox x:Name="LanguageCombo" Header="语言" SelectionChanged="LanguageCombo_SelectionChanged">
                    <ComboBoxItem Content="跟随系统" Tag="0" />
                    <ComboBoxItem Content="简体中文" Tag="1" />
                    <ComboBoxItem Content="English" Tag="2" />
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Name="StartupText" Text="启动" FontWeight="SemiBold" FontSize="14" />
                <ToggleSwitch x:Name="StartupDialogToggle" Header="启动时显示提示弹窗" OffContent="关闭" OnContent="开启" Toggled="StartupDialogToggle_Toggled" />
                <ToggleSwitch x:Name="RememberGamesToggle" Header="记住游戏列表" OffContent="关闭" OnContent="开启" Toggled="RememberGamesToggle_Toggled" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Name="GpuText" Text="显卡" FontWeight="SemiBold" FontSize="14" />
                <TextBlock x:Name="GpuTipText" Text="如果自动检测出错，可以手动选择显卡" FontSize="12" Opacity="0.7" />
                <ComboBox x:Name="GpuComboBox" Header="选择显卡" SelectionChanged="GpuComboBox_SelectionChanged" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Name="AboutText" Text="关于" FontWeight="SemiBold" FontSize="14" />
                <TextBlock x:Name="VersionText" Text="版本：V1.13.0.0" />
                <TextBlock x:Name="DevLangText" Text="开发语言：C# + WinUI 3" />
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

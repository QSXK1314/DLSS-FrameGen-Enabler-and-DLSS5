<?xml version="1.0" encoding="utf-8"?>
<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DLSSFrameGenEnabler_WinUI3.Pages"
    xmlns:models="using:DLSSFrameGenEnabler_WinUI3.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Class="DLSSFrameGenEnabler_WinUI3.Pages.HomePage"
    NavigationCacheMode="Required"
    KeyDown="HomePage_KeyDown">
    <Grid Padding="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button x:Name="AutoScanBtn" Content="自动扫描" ToolTipService.ToolTip="自动扫描Steam和Epic游戏库中的游戏" Click="AutoScanBtn_Click" />
            <Button x:Name="ManualAddBtn" Content="手动添加" ToolTipService.ToolTip="选择游戏文件夹，自动识别游戏运行exe" Click="ManualAddBtn_Click" />
            <Button x:Name="ManualAddDx9Btn" Content="手动模式（自行选择游戏exe）" ToolTipService.ToolTip="手动选择游戏exe文件，适用于自动识别失败的游戏（支持DX9/DX11/DX12）" Click="ManualAddDx9Btn_Click" />
            <Button x:Name="DetectRunningBtn" Content="检测运行中游戏" ToolTipService.ToolTip="检测当前正在运行的游戏进程，100%准确识别游戏真正的exe" Click="DetectRunningBtn_Click" />
            <Button x:Name="RefreshStatusBtn" Content="刷新状态" ToolTipService.ToolTip="重新检测所有游戏的补丁开启状态" Click="RefreshStatusBtn_Click" />
            <Button x:Name="ClearAllBtn" Content="清除列表" ToolTipService.ToolTip="一键清除游戏列表中的所有游戏" Click="ClearAllBtn_Click" />
            <ComboBox x:Name="SortComboBox" Width="120" ToolTipService.ToolTip="排序方式" SelectionChanged="SortComboBox_SelectionChanged">
                <ComboBoxItem Content="默认排序" IsSelected="True" />
                <ComboBoxItem Content="名称 A-Z" />
                <ComboBoxItem Content="名称 Z-A" />
            </ComboBox>
        </StackPanel>
        <ListView
            x:Name="GameListView"
            Grid.Row="1"
            SelectionMode="Extended"
            SelectionChanged="GameListView_SelectionChanged"
            PointerPressed="GameListView_PointerPressed"
            PointerMoved="GameListView_PointerMoved"
            PointerReleased="GameListView_PointerReleased"
            PointerCaptureLost="GameListView_PointerCaptureLost">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:GameInfo">
                    <Grid Padding="8,4,8,4">
                        <Grid.ContextFlyout>
                            <MenuFlyout Opening="GameMenuFlyout_Opening">
                                <MenuFlyoutItem Text="一键开启多帧生成" Click="CtxFrameGen_Click" />
                                <MenuFlyoutItem Text="开启DLSS5" Click="CtxDlss5_Click" />
                                <MenuFlyoutItem Text="开启DX9 DLSS5" Click="CtxDx9Dlss5_Click" />
                                <MenuFlyoutItem Text="2077专用补丁" Click="Ctx2077_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="配置多帧生成" Click="CtxConfig_Click" />
                                <MenuFlyoutItem Text="配置名修改" Click="CtxConfigName_Click" />
                                <MenuFlyoutItem Text="排错修复" Click="CtxTroubleshoot_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="一键还原" Click="CtxRestore_Click" />
                                <MenuFlyoutItem Text="启动游戏" Click="CtxLaunchGame_Click" />
                                <MenuFlyoutItem Text="打开游戏目录" Click="CtxOpenFolder_Click" />
                                <MenuFlyoutItem Text="移除列表" Click="CtxRemove_Click" />
                                <MenuFlyoutItem Text="编辑备注/标签" Click="CtxEditRemark_Click" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,8,0" Source="{x:Bind Icon, Mode=OneWay}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="SemiBold" FontSize="14" Text="{x:Bind Name, Mode=OneWay}" />
                            <TextBlock FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" Text="{x:Bind ExePath, Mode=OneWay}" />
                            <TextBlock FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" Text="{x:Bind RemarkTagsDisplay, Mode=OneWay}" Visibility="{x:Bind HasRemarkTags, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" Text="{x:Bind Status, Mode=OneWay}" />
                        <Border
                            x:Name="ToastBorder"
                            Grid.RowSpan="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,0,0,0"
                            Padding="20,14,20,14"
                            CornerRadius="8"
                            Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1,1,1,1"
                            Visibility="Collapsed"
                            Opacity="0.95"
                            MinWidth="200"
                            MaxWidth="500">
                            <TextBlock x:Name="ToastText" TextWrapping="Wrap" FontSize="14" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" TextAlignment="Center" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel
            x:Name="ActionPanel"
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="8"
            Margin="0,12,0,0"
            Visibility="Collapsed">
            <Button x:Name="FrameGenBtn" Content="一键开启多帧生成" ToolTipService.ToolTip="为选中游戏开启多帧生成功能" Click="FrameGenBtn_Click" />
            <Button x:Name="Dlss5Btn" Content="开启DLSS5" ToolTipService.ToolTip="为选中游戏开启DLSS5超分辨率" Click="Dlss5Btn_Click" />
            <Button x:Name="Dx9Dlss5Btn" Content="开启DX9 DLSS5" Visibility="Collapsed" ToolTipService.ToolTip="为DX9游戏开启DLSS5（需转译）" Click="Dx9Dlss5Btn_Click" />
            <Button x:Name="Cp2077Btn" Content="2077专用补丁" Visibility="Collapsed" ToolTipService.ToolTip="赛博朋克2077专用多帧生成补丁" Click="Cp2077Btn_Click" />
            <Button x:Name="ConfigBtn" Content="配置多帧生成" ToolTipService.ToolTip="编辑多帧生成配置文件（仅经典模式）" Click="ConfigBtn_Click" />
            <Button x:Name="ConfigNameBtn" Content="配置名修改" ToolTipService.ToolTip="修改补丁DLL配置名（仅高级模式）" Click="ConfigNameBtn_Click" />
            <Button x:Name="TroubleshootBtn" Content="排错修复" ToolTipService.ToolTip="替换sl.开头的补丁文件进行排错" Click="TroubleshootBtn_Click" />
            <Button x:Name="RestoreBtn" Content="一键还原" ToolTipService.ToolTip="还原所有已安装的补丁" Click="RestoreBtn_Click" />
        </StackPanel>
        <TextBlock
            x:Name="DisclaimerText"
            Grid.Row="3"
            Text="免责声明：不建议在网游上和带反作弊的游戏使用该软件，本质是修改文件，而修改文件则可能导致游戏封号，如果遇到游戏封号，本软件概不负责。"
            FontSize="11"
            Opacity="0.6"
            TextWrapping="Wrap"
            Margin="0,12,0,0"
            TextAlignment="Center" />
        <Border
            x:Name="ToastBorder"
            Grid.RowSpan="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="0,0,0,0"
            Padding="20,14,20,14"
            CornerRadius="8"
            Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1,1,1,1"
            Visibility="Collapsed"
            Opacity="0.95"
            MinWidth="200"
            MaxWidth="500">
            <TextBlock x:Name="ToastText" TextWrapping="Wrap" FontSize="14" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" TextAlignment="Center" />
        </Border>
    </Grid>
</Page>

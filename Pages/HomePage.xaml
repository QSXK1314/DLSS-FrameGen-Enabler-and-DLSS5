<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DLSSFrameGenEnabler_WinUI3.Pages.HomePage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DLSSFrameGenEnabler_WinUI3.Pages"
    xmlns:models="using:DLSSFrameGenEnabler_WinUI3.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部按钮 -->
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button x:Name="AutoScanBtn" Content="自动扫描" Click="AutoScanBtn_Click" ToolTipService.ToolTip="自动扫描Steam和Epic游戏库中的游戏" />
            <Button x:Name="ManualAddBtn" Content="手动添加" Click="ManualAddBtn_Click" ToolTipService.ToolTip="选择游戏文件夹，自动识别游戏运行exe" />
            <Button x:Name="ManualAddDx9Btn" Content="手动模式（自行选择游戏exe，支持dx9游戏）" Click="ManualAddDx9Btn_Click" ToolTipService.ToolTip="手动选择游戏exe文件，适用于DX9游戏或自动识别失败的游戏" />
            <Button x:Name="DetectRunningBtn" Content="检测运行中游戏" Click="DetectRunningBtn_Click" ToolTipService.ToolTip="检测当前正在运行的游戏进程，100%准确识别游戏真正的exe" />
            <Button x:Name="RefreshStatusBtn" Content="刷新状态" Click="RefreshStatusBtn_Click" ToolTipService.ToolTip="重新检测所有游戏的补丁开启状态" />
        </StackPanel>

        <!-- 游戏列表 -->
        <ListView x:Name="GameListView" Grid.Row="1" SelectionChanged="GameListView_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:GameInfo">
                    <Grid Padding="8,4">
                        <Grid.ContextFlyout>
                            <MenuFlyout Opening="GameMenuFlyout_Opening">
                                <MenuFlyoutItem Text="一键开启多帧生成" Click="CtxFrameGen_Click" />
                                <MenuFlyoutItem Text="开启DLSS5" Click="CtxDlss5_Click" />
                                <MenuFlyoutItem Text="开启DX9 DLSS5" Click="CtxDx9Dlss5_Click" />
                                <MenuFlyoutItem Text="2077专用补丁" Click="Ctx2077_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="配置多帧生成" Click="CtxConfig_Click" />
                                <MenuFlyoutItem Text="配置名修改" Click="CtxConfigName_Click" />
                                <MenuFlyoutItem Text="排错修复" Click="CtxTroubleshoot_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="一键还原" Click="CtxRestore_Click" />
                                <MenuFlyoutItem Text="打开游戏目录" Click="CtxOpenFolder_Click" />
                                <MenuFlyoutItem Text="移除列表" Click="CtxRemove_Click" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{x:Bind ExePath, Mode=OneWay}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind Status, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="2" x:Name="ActionPanel" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0" Visibility="Collapsed">
                <Button x:Name="FrameGenBtn" Content="一键开启多帧生成" Click="FrameGenBtn_Click" ToolTipService.ToolTip="为选中游戏开启多帧生成功能" />
                <Button x:Name="Dlss5Btn" Content="开启DLSS5" Click="Dlss5Btn_Click" ToolTipService.ToolTip="为选中游戏开启DLSS5超分辨率" />
                <Button x:Name="Dx9Dlss5Btn" Content="开启DX9 DLSS5" Click="Dx9Dlss5Btn_Click" Visibility="Collapsed" ToolTipService.ToolTip="为DX9游戏开启DLSS5（需转译）" />
                <Button x:Name="Cp2077Btn" Content="2077专用补丁" Click="Cp2077Btn_Click" Visibility="Collapsed" ToolTipService.ToolTip="赛博朋克2077专用多帧生成补丁" />
                <Button x:Name="ConfigBtn" Content="配置多帧生成" Click="ConfigBtn_Click" ToolTipService.ToolTip="编辑多帧生成配置文件（仅经典模式）" />
                <Button x:Name="ConfigNameBtn" Content="配置名修改" Click="ConfigNameBtn_Click" ToolTipService.ToolTip="修改补丁DLL配置名（仅高级模式）" />
                <Button x:Name="TroubleshootBtn" Content="排错修复" Click="TroubleshootBtn_Click" ToolTipService.ToolTip="替换sl.开头的补丁文件进行排错" />
                <Button x:Name="RestoreBtn" Content="一键还原" Click="RestoreBtn_Click" ToolTipService.ToolTip="还原所有已安装的补丁" />
        </StackPanel>

        <!-- 底部免责声明 -->
        <TextBlock Grid.Row="3" x:Name="DisclaimerText" Text="免责声明：不建议在网游上和带反作弊的游戏使用该软件，本质是修改文件，而修改文件则可能导致游戏封号，如果遇到游戏封号，本软件概不负责。"
                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,12,0,0" TextAlignment="Center" />
    </Grid>
</Page>

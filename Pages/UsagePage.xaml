                <TextBlock x:Name="OtherTroubleTitle" Text="" FontWeight="Bold" Margin="0,8,0,0" />
                <TextBlock x:Name="OtherTroubleContent" Text="" TextWrapping="Wrap" />
                <TextBlock x:Name="OtherRestoreTitle" Text="" FontWeight="Bold" Margin="0,8,0,0" />
                <TextBlock x:Name="OtherRestoreContent" Text="" TextWrapping="Wrap" />

                <TextBlock x:Name="Section5Title" Text="" FontWeight="Bold" FontSize="16" Margin="0,16,0,0" />
                <TextBlock x:Name="Section5Content" Text="" TextWrapping="Wrap" />

                <TextBlock x:Name="Section6Title" Text="" FontWeight="Bold" FontSize="16" Margin="0,16,0,0" />

                <TextBlock x:Name="Section2Title" Text="" FontWeight="Bold" FontSize="16" Margin="0,16,0,0" />
                <TextBlock x:Name="FgClassicTitle" Text="" FontWeight="Bold" />
                <TextBlock x:Name="FgClassicContent" Text="" TextWrapping="Wrap" />
                <TextBlock x:Name="FgAdvancedTitle" Text="" FontWeight="Bold" Margin="0,8,0,0" />
                <TextBlock x:Name="FgAdvancedContent" Text="" TextWrapping="Wrap" />
                <TextBlock x:Name="Fg2030Title" Text="" FontWeight="Bold" Margin="0,8,0,0" />
                <TextBlock x:Name="Fg2030Content" Text="" TextWrapping="Wrap" />
                <TextBlock x:Name="FgRETitle" Text="" FontWeight="Bold" Margin="0,8,0,0" />
                <TextBlock x:Name="FgREContent" Text="" TextWrapping="Wrap" />
                <TextBlock x:Name="Fg2077Title" Text="" FontWeight="Bold" Margin="0,8,0,0" />
                <TextBlock x:Name="Fg2077Content" Text="" TextWrapping="Wrap" />

                <TextBlock x:Name="Section3Title" Text="" FontWeight="Bold" FontSize="16" Margin="0,16,0,0" />
                <TextBlock x:Name="Dlss5GeneralTitle" Text="" FontWeight="Bold" />
                <TextBlock x:Name="Dlss5GeneralContent" Text="" TextWrapping="Wrap" />
                <TextBlock x:Name="Dlss5RETitle" Text="" FontWeight="Bold" Margin="0,8,0,0" />

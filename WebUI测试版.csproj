<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WebUI.Beta</RootNamespace>
    <AssemblyName>WebUI_Beta</AssemblyName>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <Version>1.75.0.0</Version>
    <FileVersion>1.75.0.0</FileVersion>
    <ProductVersion>1.75.0.0</ProductVersion>
    <AssemblyTitle>DLSS 多帧生成 + DLSS5 开启工具（测试版）</AssemblyTitle>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3719.77" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="app.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Patches\**\*" />
  </ItemGroup>
  <Target Name="CopyPatchesToPublish" AfterTargets="Publish" Condition="'$(SkipPatchesCopy)' != 'true'">
    <ItemGroup>
      <PatchFiles Include="$(MSBuildProjectDirectory)\Patches\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PatchFiles)" DestinationFiles="@(PatchFiles->'$(PublishDir)Patches\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="CopyCaptureHostToPublish" AfterTargets="Publish">
    <ItemGroup>
      <CaptureHostFiles Include="$(MSBuildProjectDirectory)\CaptureHost\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(CaptureHostFiles)" DestinationFiles="@(CaptureHostFiles->'$(PublishDir)CaptureHost\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>

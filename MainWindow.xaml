<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="DLSSFrameGenEnabler_WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DLSSFrameGenEnabler_WinUI3"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="多帧生成+DLSS5开启工具 V1.12.8.3"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航 -->
        <Grid x:Name="NavPanel" Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" Opacity="0.85" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="TitleText" Text="多帧生成+DLSS5" FontSize="14" FontWeight="Bold" Margin="16,16,12,12" TextWrapping="Wrap" />

            <ListView x:Name="NavListView" Grid.Row="1" SelectionChanged="NavListView_SelectionChanged" IsItemClickEnabled="True">
                <ListViewItem Tag="home">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE80F;" FontSize="16" />
                        <TextBlock x:Name="NavHomeText" Text="主页" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="usage">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8F2;" FontSize="16" />
                        <TextBlock x:Name="NavUsageText" Text="使用说明" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="updatelog">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8F3;" FontSize="16" />
                        <TextBlock x:Name="NavUpdateText" Text="更新内容" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
            </ListView>

            <ListView x:Name="FooterListView" Grid.Row="2" SelectionChanged="FooterListView_SelectionChanged" IsItemClickEnabled="True">
                <ListViewItem Tag="settings">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                        <TextBlock x:Name="NavSettingsText" Text="设置" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
                <ListViewItem Tag="about">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xEA3A;" FontSize="16" />
                        <TextBlock x:Name="NavAboutText" Text="关于" VerticalAlignment="Center" />
                    </StackPanel>
                </ListViewItem>
            </ListView>
        </Grid>

        <!-- 右侧内容 -->
        <Frame x:Name="NavFrame" Grid.Column="1" CacheSize="5" Background="Transparent" />
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DLSSFrameGenEnabler_WinUI3"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Class="DLSSFrameGenEnabler_WinUI3.MainWindow"
    Title="多帧生成+DLSS5开启工具 V1.12.8.3">
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid
            x:Name="NavPanel"
            Grid.Column="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Opacity="0.85"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Height="44" Margin="16,16,12,12">
                <TextBlock
                    x:Name="TitleText"
                    Text="多帧生成+DLSS5"
                    FontSize="14"
                    FontWeight="Bold"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <Image
                    x:Name="TitleIcon"
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0"
                    Stretch="Uniform" />
            </Grid>
            <ListView x:Name="NavListView" Grid.Row="1" IsItemClickEnabled="True" SelectionChanged="NavListView_SelectionChanged" Background="Transparent">
                <ListViewItem Tag="home">
                    <Grid HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE80F;" FontSize="16" HorizontalAlignment="Left" />
                        <TextBlock x:Name="NavHomeText" Grid.Column="1" Text="主页" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                </ListViewItem>
                <ListViewItem Tag="usage">
                    <Grid HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8F2;" FontSize="16" HorizontalAlignment="Left" />
                        <TextBlock x:Name="NavUsageText" Grid.Column="1" Text="使用说明" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                </ListViewItem>
                <ListViewItem Tag="updatelog">
                    <Grid HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8F3;" FontSize="16" HorizontalAlignment="Left" />
                        <TextBlock x:Name="NavUpdateText" Grid.Column="1" Text="更新内容" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                </ListViewItem>
            </ListView>
            <ListView x:Name="FooterListView" Grid.Row="2" IsItemClickEnabled="True" SelectionChanged="FooterListView_SelectionChanged" Background="Transparent">
                <ListViewItem Tag="settings">
                    <Grid HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE713;" FontSize="16" HorizontalAlignment="Left" />
                        <TextBlock x:Name="NavSettingsText" Grid.Column="1" Text="设置" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                </ListViewItem>
                <ListViewItem Tag="about">
                    <Grid HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xEA3A;" FontSize="16" HorizontalAlignment="Left" />
                        <TextBlock x:Name="NavAboutText" Grid.Column="1" Text="关于" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                </ListViewItem>
            </ListView>
            <Button
                x:Name="ToggleNavBtn"
                Grid.Row="3"
                Margin="0,4,0,4"
                Padding="16,8,16,8"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0,0,0,0"
                HorizontalContentAlignment="Left"
                Click="ToggleNavBtn_Click">
                <Grid HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="ToggleNavIcon" Grid.Column="0" Glyph="&#xE700;" FontSize="16" HorizontalAlignment="Left" />
                    <TextBlock x:Name="ToggleNavText" Grid.Column="1" Text="收起导航" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
            </Button>
        </Grid>
        <Frame x:Name="NavFrame" Grid.Column="1" CacheSize="5" Background="Transparent" />
    </Grid>
</Window>
